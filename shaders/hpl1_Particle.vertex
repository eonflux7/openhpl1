// Particles (iParticleEmitter3D with cEffectSettings::mbParticles): the
// sheets as the emitter builds them, with the light that reaches each
// corner. The original draws them at the brightness their file gives them
// wherever they are; here smoke, dust and mist are dim in the dark and
// as bright as that only where lamps or the flashlight reach them.
// Shadows are not looked at: light goes through walls to them.


const int kLights = 6;
										// of half a spotlight's cone, -2 for a point
							// (0: the original's brightness), z: brightness
							// with no light on them

out vec4 vColor;
out vec2 vUv;
out float vFogUv;
out float vDistance;

void main()
{
	gl_Position = worldViewProj * hpl_Vertex;
	// How far in front of the viewer
	vDistance = gl_Position.w;

	vUv = hpl_TexCoord.xy;
	vFogUv = (fogRange.y - gl_Position.z) / (fogRange.y - fogRange.x);
	vColor = clamp(hpl_Color, vec4(0.0), vec4(1.0));

	if(partLight.y > 0.0)
	{
		vec3 vPos = (partToWorld * hpl_Vertex).xyz;
		vec3 vLit = vec3(partLight.z);
		int lCount = int(partLight.x);
		for(int i=0; i<lCount; ++i)
		{
			vec3 vTo = vPos - partLightPos[i].xyz;
			float fReach = partLightPos[i].w;
			float fAmount = clamp(1.0 - dot(vTo, vTo) / (fReach * fReach), 0.0, 1.0);
			float fEdge = partLightColor[i].w;
			if(fEdge > -1.5)
			{
				// Full inside most of the cone, fading out to its edge
				float fCos = dot(normalize(vTo), partLightDir[i].xyz);
				fAmount *= smoothstep(fEdge, mix(fEdge, 1.0, 0.35), fCos);
			}
			vLit += partLightColor[i].rgb * fAmount;
		}
		// Never brighter than the original draws them: their files say how
		// they look in full light
		vColor.rgb *= mix(vec3(1.0), min(vLit, vec3(1.0)), partLight.y);
	}
}

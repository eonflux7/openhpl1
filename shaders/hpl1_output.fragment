// hpl1_output.fragment

// Turns the finished scene into the 8-bit output picture: tex0 is the
// scene colour (floating point, at the render size), scaled to the window
// by the texture filter. Adding noise of half a step before the conversion
// to 8 bits breaks up banding in smooth gradients; colours that are exact
// 8-bit values stay the same.
uniform sampler2D tex0;
uniform vec2 invOutputSize;

OUTPUT

// Interleaved gradient noise (Jimenez 2014): a fixed pattern in 0..1.
float Noise(vec2 avPos)
{
    return fract(52.9829189 * fract(dot(avPos, vec2(0.06711056, 0.00583715))));
}

void main()
{
    vec3 color = texture(tex0, gl_FragCoord.xy * invOutputSize).rgb;
    color += (Noise(gl_FragCoord.xy) - 0.5) / 255.0;
    outColor = vec4(color, 1.0);
}

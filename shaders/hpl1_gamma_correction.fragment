// hpl1_gamma_correction.fragment

// tex0 is a copy of the finished frame, of the same size as the window.
uniform sampler2D tex0;
uniform float gamma;

OUTPUT

void main()
{
    vec3 color = texelFetch(tex0, ivec2(gl_FragCoord.xy), 0).rgb;
    outColor = vec4(pow(color, vec3(1.0 / gamma)), 1.0);
}

///////////////////////////////////////////////////////
/// TRANSPARENT FOG FRAGMENT PROGRAM ///////////////////
///////////////////////////////////////////////////////

// Variants by blend mode: alpha (default), MOD, MODX2. Fogged
// modulative surfaces fade to the colour that leaves the frame unchanged.

in vec4 vColor;
in vec2 vUv;
in float vFogUv;

OUTPUT

HPL_TEXTURE_2D(0) //diffuseMap
uniform sampler1D tex1; //fogMap

void main()
{
#if defined(MOD) || defined(MODX2)
	vec4 diffuse = hpl_Texture0(vUv);
	float alpha = texture(tex1, vFogUv).a;
	#ifdef MOD
	outColor.xyz = diffuse.xyz * alpha + vec3(1.0 - alpha);
	#else
	outColor.xyz = diffuse.xyz * alpha + vec3(0.5,0.5,0.5)*(1 - alpha);
	#endif
	outColor.w = diffuse.w;
#else
	outColor = hpl_Texture0(vUv) * texture(tex1, vFogUv).r * vColor;
#endif
}

///////////////////////////////////////////////////////
/// LIGHTING FRAGMENT PROGRAM //////////////////////////
///////////////////////////////////////////////////////

// Variants:
//  SPOT          spotlight texture and negative rejection
//  SPECULAR      specular term, light vector normalised per pixel (the
//                others look it up in the normalisation cube map)
//  NORMAL_MAP    per-pixel normal; with SPECULAR and no SPECULAR_MAP its
//                alpha scales the specular term
//  SPECULAR_MAP  specular colour map

// Works on linear values itself when the scene holds them (linear lighting).
#define HPL_LINEAR_COLOR

#include "hpl1_light.glsl"
#include "hpl1_shadow.glsl"

OUTPUT

uniform sampler2D tex0; //diffuseMap
#ifdef NORMAL_MAP
uniform sampler2D tex1; //normalMap
#endif
#ifndef SPECULAR
uniform samplerCube tex2; //normalCubeMap
#endif
uniform sampler1D tex3; //falloffMap
#ifdef SPOT
uniform sampler2D tex4; //spotlightMap
uniform sampler1D tex5; //spotNegRejectMap
#endif
#ifdef SPECULAR_MAP
uniform sampler2D tex6; //specularMap
#endif

void main()
{
	vec3 shadowPlane = hpl_ShadowPlane(vShadowPos);

	vec3 diffuse = texture(tex0, vUv).xyz;
	float attenuation = texture(tex3, dot(vLightDir,vLightDir)).x;

#ifdef NORMAL_MAP
	vec4 bumpVec = texture(tex1, vUv);
	vec3 surfaceNormal = 2.0*bumpVec.xyz - vec3(1.0);
#else
	vec3 surfaceNormal = vec3(0.0, 0.0, 1.0);
#endif

#ifdef SPECULAR
	vec3 lightVec = normalize(vLightDir);
#else
	vec3 lightVec = (2.0*texture(tex2, vLightDir) - vec4(1.0)).xyz;
#endif

	float nDotL = dot(lightVec, surfaceNormal);
	vec3 lit = diffuse * vLightColor.xyz;

#ifdef SPOT
	vec4 spotColor = texture(tex4, vSpotlightUv.xy / vSpotlightUv.w);
	float rejectNeg = texture(tex5, vSpotlightUv.z + 0.5).x;
	lit *= spotColor.xyz;
	attenuation *= rejectNeg;
#endif

	vec3 specular = vec3(0.0);
#ifdef SPECULAR
	float specAmount = clamp(dot(normalize(vHalfVec), surfaceNormal), 0.0, 1.0);
	specAmount = pow(specAmount, 16.0) * vLightColor.w;
	#ifdef SPOT
	specAmount *= spotColor.w;
	#endif

	#if defined(SPECULAR_MAP)
	specular = specAmount * texture(tex6, vUv).xyz;
	#elif defined(NORMAL_MAP)
	specular = vec3(specAmount * clamp(bumpVec.w, 0.0, 1.0));
	#else
	specular = vec3(specAmount);
	#endif
#endif

	// Where the light does not reach anyway the shadow map is not read
	float shadow = 1.0;
	if(attenuation > 0.0) shadow = hpl_Shadow(vShadowPos, shadowPlane);
	if(hpl_ShadowMap1.w > 0.5)
	{
		// The shadow alone, as far as the light reaches
		outColor = vec4(hpl_ToLinear(vec3(0.25 * shadow * step(0.001, attenuation))), 0.0);
		return;
	}

	if(hpl_ColorSpace.x > 0.5)
	{
		// Diffuse and specular are converted one by one and added as
		// light. Facing away from the light the diffuse term is negative
		// and takes from the specular one, as it does below.
		if(nDotL < 0.0) specular = max(specular + lit * nDotL, 0.0);

		// The amount of light (N.L and the falloff ramp) has a power of its
		// own: cLinearLightingTuning::mfLightExp.
		float amountExp = hpl_ColorSpace.z;
		vec3 color = hpl_ToLinear(lit) * pow(max(nDotL, 0.0) * attenuation, amountExp);
		color += hpl_ToLinear(specular) * pow(attenuation, amountExp);
		outColor = vec4(color * shadow, 0.0);
	}
	else
	{
		outColor = vec4((lit * nDotL + specular) * attenuation * shadow, 0.0);
	}
}

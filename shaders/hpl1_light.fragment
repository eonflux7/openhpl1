///////////////////////////////////////////////////////
/// LIGHTING FRAGMENT PROGRAM //////////////////////////
///////////////////////////////////////////////////////

// Variants:
//  SPOT          spotlight texture and negative rejection
//  SPECULAR      highlights: hpl_Highlight() of hpl1_shading.glsl
//  NORMAL_MAP    per-pixel normal; with SPECULAR and no SPECULAR_MAP its
//                alpha is the specular map
//  SPECULAR_MAP  specular colour map

// Works on linear values itself.
#define HPL_LINEAR_COLOR

#include "hpl1_light.glsl"
#include "hpl1_shadow.glsl"
#include "hpl1_light_look.glsl"
#ifdef SPECULAR
#include "hpl1_shading.glsl"
#endif

OUTPUT

HPL_TEXTURE_2D(0) //diffuseMap
#ifdef NORMAL_MAP
HPL_TEXTURE_2D(1) //normalMap
#endif
uniform sampler1D tex3; //falloffMap
#ifdef SPOT
HPL_TEXTURE_2D(4) //spotlightMap
#endif
#ifdef SPECULAR_MAP
HPL_TEXTURE_2D(6) //specularMap
#endif

void main()
{
	vec3 shadowPlane = hpl_ShadowPlane(vShadowPos);

	vec3 diffuse = hpl_Texture0(vUv).xyz;
	float attenuation = texture(tex3, dot(vLightDir,vLightDir)).x;
	if(hpl_Light0.x > 0.5) attenuation = hpl_DistanceFalloff(dot(vLightDir,vLightDir));

#ifdef NORMAL_MAP
	vec4 bumpVec = hpl_Texture1(vUv);
	vec3 surfaceNormal = 2.0*bumpVec.xyz - vec3(1.0);
#else
	vec3 surfaceNormal = vec3(0.0, 0.0, 1.0);
#endif

	vec3 lightVec = normalize(vLightDir);

	float nDotL = dot(lightVec, surfaceNormal);
	// Tint and brightness: 1 for a light as the game made it
	vec3 lightColor = vLightColor.xyz * hpl_Light2.xyz;
	vec3 lit = diffuse * lightColor;

#ifdef SPOT
	vec4 spotColor = hpl_Texture4(vSpotlightUv.xy / vSpotlightUv.w);
	if(hpl_Light1.x > 0.5) spotColor = hpl_Beam(vSpotlightUv.xy / vSpotlightUv.w);
	// Nothing behind the light, over a short ramp as the two texels of
	// the original's look-up texture gave
	float rejectNeg = clamp(2.0*vSpotlightUv.z + 0.5, 0.0, 1.0);
	lit *= spotColor.xyz;
	attenuation *= rejectNeg;
#endif

	// The amount of light (N.L and the falloff ramp) has a power of its
	// own: cLinearLightingTuning::mfLightExp. The ramp was made to look
	// right on screen values.
	float amountExp = hpl_ColorSpace.z;

#ifdef SPECULAR
	#if defined(SPECULAR_MAP)
	vec3 specularMap = hpl_Texture6(vUv).xyz;
	#elif defined(NORMAL_MAP)
	vec3 specularMap = vec3(clamp(bumpVec.w, 0.0, 1.0));
	#else
	vec3 specularMap = vec3(1.0);
	#endif

	// The highlight as an amount of light, of the light's colour
	vec3 highlightColor = lightColor;
	#ifdef SPOT
	highlightColor *= spotColor.xyz;
	#endif
	vec3 toEye = hpl_Normalize(vEyeVec);
	vec3 highlightVec = lightVec;
	float spread = 1.0;
	if(hpl_Light0.w > 0.5)
	{
		// A tube: the highlight is as long as the tube is
		float rough = hpl_Roughness(specularMap);
		highlightVec = hpl_TubeDirection(vTubeCentre, vTubeAxis, toEye, hpl_Normalize(surfaceNormal));
		spread = hpl_TubeSpread(vTubeCentre, vTubeAxis, rough * rough);
	}
	vec3 highlight = hpl_Highlight(surfaceNormal, highlightVec, toEye, specularMap) *
					pow(highlightColor, vec3(2.2)) * (spread * vLightColor.w * pow(attenuation, amountExp));
	// Nothing where the light is behind the surface itself, whatever the
	// normal map says
	highlight *= clamp(lightVec.z * 8.0, 0.0, 1.0);
	// Faces whose tangents are not numbers get no light in the original
	// either
	if(!(dot(highlight, vec3(1.0)) >= 0.0)) highlight = vec3(0.0);
#endif

	// Where the light does not reach anyway the shadow map is not read
	float shadow = 1.0;
	if(attenuation > 0.0) shadow = hpl_Shadow(vShadowPos, shadowPlane);
	if(hpl_ShadowMap1.w > 0.5)
	{
		// The shadow alone, as far as the light reaches
		outColor = vec4(hpl_ToLinear(vec3(0.25 * shadow * step(0.001, attenuation))), 0.0);
		return;
	}

	vec3 color = hpl_ToLinear(lit) * pow(max(nDotL, 0.0) * attenuation, amountExp);
#ifdef SPECULAR
	color += highlight;
#endif
	outColor = vec4(color * shadow, 0.0);
}

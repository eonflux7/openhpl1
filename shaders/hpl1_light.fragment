///////////////////////////////////////////////////////
/// LIGHTING FRAGMENT PROGRAM //////////////////////////
///////////////////////////////////////////////////////

// Variants:
//  SPOT          spotlight texture and negative rejection
//  SPECULAR      specular term, light vector normalised per pixel (the
//                others look it up in the normalisation cube map)
//  NORMAL_MAP    per-pixel normal; with SPECULAR and no SPECULAR_MAP its
//                alpha scales the specular term
//  SPECULAR_MAP  specular colour map

#include "hpl1_light.glsl"

OUTPUT

uniform sampler2D tex0; //diffuseMap
#ifdef NORMAL_MAP
uniform sampler2D tex1; //normalMap
#endif
#ifndef SPECULAR
uniform samplerCube tex2; //normalCubeMap
#endif
uniform sampler1D tex3; //falloffMap
#ifdef SPOT
uniform sampler2D tex4; //spotlightMap
uniform sampler1D tex5; //spotNegRejectMap
#endif
#ifdef SPECULAR_MAP
uniform sampler2D tex6; //specularMap
#endif

void main()
{
	vec3 diffuse = texture(tex0, vUv).xyz;
	float attenuation = texture1D(tex3, dot(vLightDir,vLightDir)).x;

#ifdef NORMAL_MAP
	vec4 bumpVec = texture(tex1, vUv);
	vec3 surfaceNormal = 2.0*bumpVec.xyz - vec3(1.0);
#else
	vec3 surfaceNormal = vec3(0.0, 0.0, 1.0);
#endif

#ifdef SPECULAR
	vec3 lightVec = normalize(vLightDir);
#else
	vec3 lightVec = (2.0*textureCube(tex2, vLightDir) - vec4(1.0)).xyz;
#endif

	vec3 color = diffuse * vLightColor.xyz * dot(lightVec, surfaceNormal);

#ifdef SPOT
	vec4 spotColor = texture(tex4, vSpotlightUv.xy / vSpotlightUv.w);
	float rejectNeg = texture1D(tex5, vSpotlightUv.z + 0.5).x;
	color *= spotColor.xyz;
	attenuation *= rejectNeg;
#endif

#ifdef SPECULAR
	float specular = clamp(dot(normalize(vHalfVec), surfaceNormal), 0.0, 1.0);
	specular = pow(specular, 16.0) * vLightColor.w;
	#ifdef SPOT
	specular *= spotColor.w;
	#endif

	#if defined(SPECULAR_MAP)
	color += specular * texture(tex6, vUv).xyz;
	#elif defined(NORMAL_MAP)
	color += specular * clamp(bumpVec.w, 0.0, 1.0);
	#else
	color += specular;
	#endif
#endif

	outColor = vec4(color * attenuation, 0.0);
}

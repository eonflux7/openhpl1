///////////////////////////////////////////////////////
/// BLOOOM FRAGMENT PROGRAM /////////////////
///////////////////////////////////////////////////////

// Converts linear values itself, to keep what is brighter than white.
#define HPL_LINEAR_COLOR

in vec2 vUv0;

OUTPUT

uniform sampler2D tex0; //blurTex
uniform sampler2D tex1; //screenTex, of the render size

void main()
{
	vec4 blurCol = texture(tex0, vUv0);
	vec4 screenCol = texelFetch(tex1, ivec2(gl_FragCoord.xy), 0);

	// The sum below was made for screen values, and for a blur that ends
	// at white.
	blurCol.xyz = min(hpl_ToEncoded(blurCol.xyz), 1.0);
	screenCol.xyz = hpl_ToEncoded(screenCol.xyz);

	blurCol *= blurCol;
	outColor.xyz = hpl_ToLinear(blurCol.xyz * dot(blurCol.xyz,vec3(0.3, 0.58, 0.12)) + screenCol.xyz);
}

///////////////////////////////////////////////////////
/// REFRACTION VERTEX PROGRAM ////////////
///////////////////////////////////////////////////////

#define position (hpl_Vertex)
#define color (hpl_Color)
#define uv (hpl_MultiTexCoord0.xy)
#define normal (hpl_Normal)

out vec4 vColor;
out vec2 vUv;
out vec3 vNormal;
out vec3 vEyePos;


void main()
{
	gl_Position = (worldViewProj * position);

	vColor = clamp(color, vec4(0.0), vec4(1.0));

	vUv = uv;

	vNormal = normal;

	vEyePos = normalize(EyePos - position.xyz);
}
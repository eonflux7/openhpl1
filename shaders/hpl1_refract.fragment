///////////////////////////////////////////////////////
/// REFRACTION FRAGMENT PROGRAM /////////////////
///////////////////////////////////////////////////////

// Reads and writes linear values.
#define HPL_LINEAR_COLOR

in vec2 vUv; //in object space
in vec4 vColor;

OUTPUT

HPL_TEXTURE_2D(0) //screenMap, of the render size
HPL_TEXTURE_2D(1) //refractMap


void main()
{
	vec3 offset = vec3(((hpl_Texture1(vUv)*2.0) - vec4(1.0)) * vColor.w);

	outColor = hpl_Texture0((gl_FragCoord.xy - (offset.xy*scale) / gl_FragCoord.z) / vec2(hpl_TextureSize0(0)));
}

///////////////////////////////////////////////////////
/// DEPTH OF FIELD FRAGMENT PROGRAM /////////////////
///////////////////////////////////////////////////////

// SKY: for the sky box, which is drawn over all of the screen: blurred
// by the most there is.
// Reads and writes linear values.
#define HPL_LINEAR_COLOR

in float vDepth;

#include "hpl1_frame.glsl"

OUTPUT

uniform sampler2D tex0; //screenMap, of the render size
uniform sampler2D tex1; //blurMap
uniform vec3 planes;
uniform float maxBlur;

void main()
{
#ifdef SKY
	float blur = maxBlur;
#else
	float blur = 0.0;

	if(vDepth < planes.y) {
		blur = (planes.y - vDepth) / (planes.y - planes.x);
	}
	else {
		blur = (vDepth - planes.y) / (planes.z - planes.y);
	}

	blur = clamp(blur, 0.0, maxBlur);
#endif

	outColor = texelFetch(tex0,ivec2(gl_FragCoord.xy),0) * (1.0-blur) + texture(tex1,gl_FragCoord.xy/hpl_RenderSize.xy) *blur;
}

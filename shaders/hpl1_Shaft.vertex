// A shaft of light (cBillboard with cEffectSettings::mbShafts): the box
// round it, in the shaft's own space (y along the shaft, the middle at 0).


out vec3 vLocalPos;

void main()
{
	gl_Position = worldViewProj * hpl_Vertex;
	vLocalPos = hpl_Vertex.xyz;
}

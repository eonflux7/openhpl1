///////////////////////////////////////////////////////
/// LIGHTING VERTEX PROGRAM ////////////////////////////
///////////////////////////////////////////////////////

// Variants: SPOT, SPECULAR (see hpl1_light.glsl)

#define position (hpl_Vertex)
#define normal (hpl_Normal)
#define uv (hpl_MultiTexCoord0.xy)
#define tangent (hpl_MultiTexCoord1)

#include "hpl1_light.glsl"

uniform mat4 worldViewProj;
#ifdef SPOT
uniform mat4 spotViewProj;
#endif
#ifdef SPECULAR
uniform vec3 EyePos;
uniform vec3 TubeCentre;
uniform vec3 TubeAxis;
#endif
uniform vec3 LightPos;
uniform vec4 LightColor;
uniform vec3 LightDirMul;
uniform mat4 shadowMtx;

void main()
{
	gl_Position = (worldViewProj * position);

	vUv = uv;

#ifdef SPOT
	vSpotlightUv = (spotViewProj * position);
#endif

	vShadowPos = (shadowMtx * position).xyz;

	vec3 lightDir = LightPos - position.xyz;
	vLightDir = lightDir * LightDirMul;

	//Calculate rotation for light to get it to tangent space.
	vec3 binormal = cross(normal,tangent.xyz)*tangent.w;
	mat3 rotation = transpose(mat3(tangent.xyz, binormal, normal));

	//Transform the lightdir
	vLightDir = (rotation * vLightDir);

#ifdef SPECULAR
	//Towards the eye, in tangent space
	vEyeVec = (rotation * (EyePos - position.xyz));

	vTubeCentre = (rotation * (TubeCentre - position.xyz));
	vTubeAxis = (rotation * TubeAxis);
#endif

	vLightColor = clamp(LightColor, vec4(0.0), vec4(1.0));
}

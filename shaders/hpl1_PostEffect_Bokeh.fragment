// Depth of field from the depth buffer
// (cRendererPostEffects::RenderDepthOfFieldBokeh): what is out of focus is
// spread over a disc, as a lens does, wider the further it is from the
// distance in focus. What is in focus stays as sharp as it was drawn.
//
// The game gives three distances: in focus, and the near and the far one
// at which the blur is full. In between the blur grows evenly, as in the
// original effect, up to an amount the game fades in and out.
//
// The blur is made at half the scene's size, by gathering: every pixel
// looks at the pixels on a disc around it and takes those whose own blur
// reaches it (Jimenez: Next Generation Post Processing in Call of Duty:
// Advanced Warfare, 2014; laid out as in Unity's post-processing stack).
// What is behind the focus and what is in front of it are gathered apart:
// the blur of what is behind must not take in sharp things in front of it,
// and the blur of what is in front spreads over whatever is behind it.
//
//  PREFILTER  tex0: the scene copy -> half size, with how far
//             out of focus each pixel is in alpha
//  GATHER     tex0: that -> the blurred picture; alpha: how much of the
//             pixel the blur of things in front covers
//  FILL       tex0: that -> the same, with the gaps between the samples
//             smoothed over
//  COMPOSITE  tex0: that, tex1: the scene copy -> the scene
//
// The textures hold linear values: light is what
// a lens spreads, and bright points become discs.

#define HPL_LINEAR_COLOR
#define HPL_NO_CLAMP

OUTPUT

#include "hpl1_scene_depth.glsl"

//////////////////////////////////////////////////////////////////////////
#if defined(PREFILTER) || defined(COMPOSITE) || (!defined(GATHER) && !defined(FILL))

// Distances from the camera: x: full blur in front, y: in focus, z: full
// blur behind
// x: the most blur there is now, 0 to 1; y: the radius of full blur in
// pixels of the scene

// How far out of focus a pixel of the scene is: 0 in focus, 1 fully
// blurred behind it, -1 in front of it.
float PixelBlur(ivec2 avPixel)
{
	float depth = hpl_SceneDepthAt(avPixel);
	float dist = depth >= 1.0 ? 100000.0 : hpl_ViewDistance(depth);

	bool inFront = dist < planes.y;
	float amount = inFront ?	(planes.y - dist) / max(planes.y - planes.x, 0.0001) :
								(dist - planes.y) / max(planes.z - planes.y, 0.0001);
	// The blur grows slowly at first: around the distance in focus there
	// is a zone that is sharp, not a line. With the blur growing evenly,
	// a floor running through the focus showed a narrow sharp band across
	// it.
	amount = min(amount, 1.0);
	amount = min(amount * amount, blur.x);
	return inFront ? -amount : amount;
}

#endif

//////////////////////////////////////////////////////////////////////////
#if defined(PREFILTER)

uniform sampler2D tex0;

void main()
{
	ivec2 last = ivec2(hpl_RenderSize.xy) - 1;
	ivec2 start = ivec2(gl_FragCoord.xy) * 2;

	// The four pixels of the scene under this one. Bright ones count less,
	// or a single one flickers as it moves over the grid. Of their blurs
	// the largest is kept: an edge between sharp and blurred is blurred
	// here, and sharp again in the composite, which looks at every pixel.
	vec3 sum = vec3(0.0);
	float weights = 0.0;
	float least = 1.0, most = -1.0;
	for(int i = 0; i < 4; ++i)
	{
		ivec2 pixel = min(start + ivec2(i & 1, i >> 1), last);
		vec3 color = min(texelFetch(tex0, pixel, 0).rgb, 16.0);
		float weight = 1.0 / (1.0 + max(color.r, max(color.g, color.b)));
		sum += color * weight;
		weights += weight;

		float amount = PixelBlur(pixel);
		least = min(least, amount);
		most = max(most, amount);
	}

	outColor = vec4(sum / weights, (most >= -least ? most : least) * 0.5 + 0.5);
}

//////////////////////////////////////////////////////////////////////////
#elif defined(GATHER)

uniform sampler2D tex0;

// In pixels of tex0: x: the radius of full blur; z: the radius of the most
// blur there is now, which is as far as the samples go. y: rings of samples

// A blur's edge is this many pixels soft
const float kMargin = 2.0;

vec4 gBehind = vec4(0.0);
vec4 gInFront = vec4(0.0);
// The samples in front, by how far their blur is wide enough for this
// picture to show it
float gInFrontShown = 0.0;
// The pixel's own blur radius, in pixels
float gOwnRadius;

void Gather(vec4 avSample, float afDist)
{
	float radius = (avSample.a * 2.0 - 1.0) * disc.x;

	float behind;
	if(gOwnRadius < 0.0)
	{
		// The pixel is in front of the focus and blurred, so what is
		// behind it shows through: taken from the samples around it that
		// are not in front, as far as its own blur reaches
		behind = clamp(radius + 1.0, 0.0, 1.0) * clamp((-gOwnRadius - afDist + kMargin) / kMargin, 0.0, 1.0);
	}
	else
	{
		// Behind the focus: a sample reaches the pixel if its blur does,
		// and no further than the pixel's own, or the blurred background
		// would spread over sharp things that are in front of it
		behind = clamp((max(min(gOwnRadius, radius), 0.0) - afDist + kMargin) / kMargin, 0.0, 1.0);
	}
	gBehind += vec4(avSample.rgb, 1.0) * behind;

	// In front of it: a sample reaches wherever its blur does, and counts
	// for less the wider it is spread: its light is shared out over its
	// disc
	float size = max(-radius, 1.0);
	float inFront = clamp((-radius - afDist + kMargin) / kMargin, 0.0, 1.0) * step(0.75, -radius) *
					(disc.z * disc.z) / (size * size);
	gInFront += vec4(avSample.rgb, 1.0) * inFront;
	// The same first few pixels of blur over which the composite brings
	// this picture in for a pixel's own blur
	gInFrontShown += inFront * smoothstep(0.75, 3.0, -radius);
}

void main()
{
	vec2 texel = 1.0 / vec2(textureSize(tex0, 0));
	vec2 uv = gl_FragCoord.xy * texel;

	vec4 own = texture(tex0, uv);
	gOwnRadius = (own.a * 2.0 - 1.0) * disc.x;
	Gather(own, 0.0);

	// Rings of samples that cover the disc evenly: seven more on each
	// ring than on the one inside it, each ring turned against the last
	int rings = int(disc.y);
	float count = 1.0;
	for(int ring = 1; ring <= rings; ++ring)
	{
		int samples = ring * 7;
		float radius = disc.z * float(ring) / float(rings);
		float angle = 6.2831853 / float(samples);
		mat2 turn = mat2(cos(angle), sin(angle), -sin(angle), cos(angle));
		vec2 dir = vec2(cos(float(ring) * 1.3), sin(float(ring) * 1.3));

		for(int i = 0; i < samples; ++i)
		{
			Gather(texture(tex0, uv + dir * radius * texel), radius);
			dir = turn * dir;
		}
		count += float(samples);
	}

	// How much of the pixel the blur of the things in front hides: all of
	// it inside them, less and less outside their outline. Things that are
	// only a little out of focus hide less: their blur is too small for a
	// picture of half the size, and switching to it at once drew a line
	// across a floor where its blur began.
	float cover = clamp(gInFront.a / count, 0.0, 1.0) * gInFrontShown / max(gInFront.a, 0.0001);
	vec3 inFront = gInFront.rgb / max(gInFront.a, 0.0001);
	// Nothing behind was found deep inside something in front
	vec3 behind = gBehind.a > 0.0001 ? gBehind.rgb / gBehind.a : inFront;

	// A pixel in focus is drawn sharp by the composite, which lays this
	// picture over it by the cover: there it holds the blur of the things
	// in front alone. Elsewhere that blur lies over what is behind it.
	float inFocus = 1.0 - smoothstep(1.0, 2.0, abs(gOwnRadius));
	float share = mix(cover, 1.0, inFocus * clamp(cover * 20.0, 0.0, 1.0));
	outColor = vec4(mix(behind, inFront, share), cover);
}

//////////////////////////////////////////////////////////////////////////
#elif defined(FILL)

uniform sampler2D tex0;

// Four samples between the pixels: a small tent over 3x3 of them.
void main()
{
	vec2 texel = 1.0 / vec2(textureSize(tex0, 0));
	vec2 uv = gl_FragCoord.xy * texel;
	vec2 h = texel * 0.5;

	outColor = (texture(tex0, uv + vec2(-h.x, -h.y)) + texture(tex0, uv + vec2(h.x, -h.y)) +
				texture(tex0, uv + vec2(-h.x, h.y)) + texture(tex0, uv + vec2(h.x, h.y))) * 0.25;
}

//////////////////////////////////////////////////////////////////////////
#else

uniform sampler2D tex0;
uniform sampler2D tex1;

void main()
{
	ivec2 pixel = ivec2(gl_FragCoord.xy);
	vec4 blurred = texture(tex0, gl_FragCoord.xy * 0.5 / vec2(textureSize(tex0, 0)));

	// The pixel's own blur decides, so that what is sharp keeps its edge
	// against a blurred background: the blurred picture comes in
	// gradually over the first few pixels of blur, which half the size
	// cannot show.
	// Over what is in focus, the blur of things in front of it lies as
	// far as the gather found it to cover.
	float own = smoothstep(1.5, 6.0, abs(PixelBlur(pixel)) * blur.y);
	float share = own + blurred.a - own * blurred.a;

	// In focus: the scene as it is
	if(share <= 0.0) discard;

	vec3 sharp = texelFetch(tex1, pixel, 0).rgb;
	outColor = vec4(mix(sharp, blurred.rgb, share), 1.0);
}

#endif

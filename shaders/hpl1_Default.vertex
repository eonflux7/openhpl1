// What is drawn without a program of its own: the HUD, fonts, menus,
// particles, billboards, beams, transparent materials without fog and
// debug lines. worldViewProj is set by cLowLevelGraphicsSDL::PrepareDraw
// from the model-view and projection matrices.


out vec4 vColor;
out vec3 vUv;

void main()
{
	gl_Position = worldViewProj * hpl_Vertex;
	vColor = clamp(hpl_Color, 0.0, 1.0);
	vUv = hpl_TexCoord.xyz;
}

///////////////////////////////////////////////////////
/// AMBIENT FRAGMENT PROGRAM, IMPROVED SHADING /////////
///////////////////////////////////////////////////////

// The first pass over a lit material, which also fills the depth buffer.
// The original (hpl1_Ambient_Color.fragment) is texture x ambient colour:
// the same from every side, so a normal map shows only where a light
// reaches. Here the ambient light has a direction or two, and what has
// specular mirrors some of it at grazing angles (cShadingSettings).
//
// Variants:
//  NORMAL_MAP    per-pixel normal
//  SPECULAR      sheen; the specular amount is 1, or the normal map's alpha
//  SPECULAR_MAP  the specular amount is a colour map

#include "hpl1_shading.glsl"

in vec2 vUv;
in vec3 vWorldPos;
in vec3 vTangent;
in vec3 vBinormal;
in vec3 vNormal;

OUTPUT

HPL_TEXTURE_2D(0) //diffuseMap
#ifdef NORMAL_MAP
HPL_TEXTURE_2D(1) //normalMap
#endif
#ifdef SPECULAR_MAP
HPL_TEXTURE_2D(6) //specularMap
#endif

void main()
{
	outColor = hpl_Texture0(vUv);

	// Some faces in the game's meshes have tangents, or normals, that are
	// not numbers. The original shaders draw those with the plain ambient
	// colour and no light; here they fall back to the face's own normal,
	// then to the plain ambient colour.
	vec3 normal = hpl_Normalize(vNormal);
#ifdef NORMAL_MAP
	vec4 bumpVec = hpl_Texture1(vUv);
	vec3 bump = 2.0*bumpVec.xyz - vec3(1.0);
	vec3 bumped = hpl_Normalize(bump.x * hpl_Normalize(vTangent) + bump.y * hpl_Normalize(vBinormal) + bump.z * normal);
	if(dot(bumped, bumped) > 0.5) normal = bumped;
#endif
	bool known = dot(normal, normal) > 0.5;
	vec3 toEye = hpl_Normalize(hpl_EyePos.xyz - vWorldPos);
	float facing = known ? clamp(dot(normal, toEye), 0.0, 1.0) : 0.6;
	float up = known ? normal.y : 0.0;

	// More from above than from below, and more on what faces the viewer.
	// Both leave a surface seen at a middling angle as bright as it was.
	float amount = (1.0 + hpl_Shading1.z * up) * (1.0 + hpl_Shading1.w * (facing - 0.6));
	outColor.xyz *= ambientColor * amount;

#ifdef SPECULAR
	#if defined(SPECULAR_MAP)
	vec3 specularMap = hpl_Texture6(vUv).xyz;
	#elif defined(NORMAL_MAP)
	vec3 specularMap = vec3(clamp(bumpVec.w, 0.0, 1.0));
	#else
	vec3 specularMap = vec3(1.0);
	#endif

	// The ambient light is taken to come from all around. Colours here are
	// screen values, so the share that is mirrored is converted to one.
	vec3 mirrored = hpl_AmbientMirror(specularMap, facing);
	if(known) outColor.xyz += ambientColor * pow(mirrored, vec3(1.0 / 2.2)) * hpl_Shading0.w * (1.0 + hpl_Shading1.z * up);
#endif
}

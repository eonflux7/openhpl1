///////////////////////////////////////////////////////
/// AMBIENT DIFFUSE COLOR FRAG PROGRAM ////////////
///////////////////////////////////////////////////////

in vec4 vLightColor;
in vec2 vUv;

OUTPUT

HPL_TEXTURE_2D(0) //diffuseMap

void main()
{
	outColor = hpl_Texture0(vUv);
	outColor.xyz *= ambientColor;
}
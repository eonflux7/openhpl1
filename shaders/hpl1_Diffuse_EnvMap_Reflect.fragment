// Diffuse_EnvMap_Reflect.fragment

in vec3 vColor;
in vec3 vUv;
in vec3 vUv2;

OUTPUT

HPL_TEXTURE_2D(0) // diffuse
uniform samplerCube tex1;

void main() {
	vec4 diffuseColor = hpl_Texture0(vUv.st);
	vec4 reflectedColor = texture(tex1, vUv2);
	outColor = mix(diffuseColor, reflectedColor, diffuseColor.a);
}